; SPDX-License-Identifier: MIT
;
; CH446Q crosspoint shifter with the chip-select strobe done by a CPU ISR - the
; LEGACY program: the OG's path, and V5's fallback when the PIO2 strobe SM
; (ch446_pio2cs.pio, T3.2) cannot be set up.
;
; THIS FILE IS THE SOURCE OF TRUTH FOR ch446.pio.h. The PlatformIO raspberrypi
; platform re-runs pioasm on every *.pio under src/ whose mtime is newer than
; its .pio.h (builder/frameworks/_build_pioasm.py) - so a checkout, stash or
; touch that makes this file newer REGENERATES the header. For a long time the
; header was hand-edited (flag 1, the IRQ1 line, drive strength) while this
; source still said flag 0, and one such regeneration (2026-08-18) silently
; put a shifter that waits on flag 0 in front of an ISR that clears flag 1.
; Keep the two in sync by editing THIS file and regenerating:
;   ~/.platformio/packages/tool-pioasm-rp2040-earlephilhower/pioasm src/ch446.pio src/ch446.pio.h
;
; It is SPI-like: 8 bits out MSB first (7 address bits, then the switch data
; bit held on DAT), then it raises PIO IRQ flag 1 (-> PIO0_IRQ_1 -> isrFromPio
; in CH446Q.cpp, which pulses the chip's STB and clears the flag) and waits for
; the flag to clear before the next word.

.program spi_ch446_multi_cs
.side_set 1

.wrap_target
bitloop:
    out pins, 1        side 0x0 [2]
    nop                side 0x1 [2]
    jmp x-- bitloop    side 0x1
    out pins, 1        side 0x1
    mov x, y           side 0x1
    irq nowait 1       side 0x1     ; flag 1 -> the CPU ISR strobes the chip select
    wait 0 irq 1 rel   side 0x1     ; ... and clears the flag when the pulse is done
    jmp !osre bitloop  side 0x0
public entry_point:                 ; Must set X,Y to n-2 before starting!
    pull ifempty       side 0x0 [1] ; Block with CSn high (minimum 2 cycles)
    nop                side 0x0 [1] ; CSn front porch
.wrap

% c-sdk {
// The shifter init used by CH446Q.cpp's legacy path (the pio2cs shifter has
// its own init in CH446Q.cpp). Side-set = CK, out pin = DAT; flag 1 routed to
// PIO0_IRQ_1, which initCH446Q() enables on the core that registers isrFromPio.
#include "hardware/gpio.h"
static inline void pio_spi_ch446_multi_cs_init(PIO pio, uint sm, uint prog_offs, uint n_bits, float clkdiv, bool cpha, bool cpol,
                                               uint pin_sck, uint pin_mosi) {
    (void)cpha; (void)cpol;
    pio_sm_config c = spi_ch446_multi_cs_program_get_default_config(prog_offs);
    sm_config_set_out_pins(&c, pin_mosi, 1);
    sm_config_set_set_pins(&c, pin_sck, 1);
    sm_config_set_sideset_pins(&c, pin_sck);
    sm_config_set_out_shift(&c, false, true, n_bits);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_mosi, 2, true);
    gpio_set_drive_strength(pin_sck, GPIO_DRIVE_STRENGTH_12MA);
    gpio_set_drive_strength(pin_mosi, GPIO_DRIVE_STRENGTH_12MA);
    gpio_set_slew_rate(pin_sck, GPIO_SLEW_RATE_FAST);
    gpio_set_slew_rate(pin_mosi, GPIO_SLEW_RATE_FAST);
    pio_gpio_init(pio, pin_mosi);
    pio_gpio_init(pio, pin_sck);
    // The IRQ source is per flag; "1 rel" on state machine 0 is flag 1, and
    // isrFromPio clears flag 1 - so this must be interrupt1 + sm.
    pio_set_irq1_source_enabled(pio, (pio_interrupt_source)(pis_interrupt1 + sm), true);
    pio_interrupt_clear(pio, sm);
    irq_set_enabled(PIO0_IRQ_1, true);
    uint entry_point = prog_offs;
    pio_sm_init(pio, sm, entry_point, &c);
    pio_sm_exec(pio, sm, pio_encode_set(pio_x, n_bits - 2));
    pio_sm_exec(pio, sm, pio_encode_set(pio_y, n_bits - 2));
    pio_sm_set_enabled(pio, sm, true);
}
%}
